include Makefile.curl

SYNOLOGY_URL := https://global.download.synology.com/download/Document/Software/DeveloperGuide/Firmware/DSM/All/enu/Synology_MIB_File.zip

all: synology/.done

synology/.done:
	$(eval TMP := $(shell mktemp))
	@echo ">> Downloading Synology Mibs"
	@curl $(CURL_OPTS) -o $(TMP) "$(SYNOLOGY_URL)"
	@unzip -d synology -o -j $(TMP)
	# Patch to add diskSMARTAttrRaw64.
	@patch synology/SYNOLOGY-SMART-MIB.txt synology/patches/SYNOLOGY-SMART-MIB.0.patch
	# Add cpuUtilization, memUtilization and thermalStatus, documented in the MIB
	# Guide but missing from the published MIB download.
	@patch synology/SYNOLOGY-SYSTEM-MIB.txt synology/patches/SYNOLOGY-SYSTEM-MIB.0.patch
	@rm $(TMP)
	@touch $@

.PHONY: clean
clean:
	rm -rvf synology/SYNOLOGY-*txt synology/.done
