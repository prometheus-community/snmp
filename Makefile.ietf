include Makefile.curl

# MIB is defined in RFC1657 which annoyingly contains lots of formating. Using
# the public Cisco mib repository here as it contains a cleaned up version.
BGP4_MIB_URL := https://raw.githubusercontent.com/cisco/cisco-mibs/refs/heads/main/v2/BGP4-MIB.my

all: ietf/BGP4-MIB

ietf/BGP4-MIB:
	@echo ">> Downloading BGP4-MIB"
	@curl $(CURL_OPTS) -o $@ "$(BGP4_MIB_URL)"

.PHONY: clean
clean:
	rm -rvf ietf/BGP4-MIB
