include Makefile.curl

LLDP_MIB_URL := https://www.ieee802.org/1/files/public/MIBs/LLDP-MIB-200505060000Z.mib

all: ieee/LLDP-MIB

ieee/LLDP-MIB:
	@echo ">> Downloading LLDP-MIB"
	@curl $(CURL_OPTS) -o $@ "$(LLDP_MIB_URL)"

.PHONY: clean
clean:
	rm -rvf ieee/LLDP-MIB
